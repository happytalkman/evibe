{
  "name": "evide",
  "displayName": "Evide - eGov Java Vibe Engine",
  "description": "Validated eGovFrame 5 Java/DDL and PMO generation from natural language.",
  "version": "0.1.0",
  "publisher": "evide-local",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": { "node": ">=22.18.0", "vscode": "^1.96.0" },
  "main": "./dist/extension.cjs",
  "categories": ["Other"],
  "activationEvents": ["onView:egovvibe.sidebar"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "egovvibe", "title": "Evide", "icon": "media/icon.svg" }]
    },
    "views": {
      "egovvibe": [{ "type": "webview", "id": "egovvibe.sidebar", "name": "eGov Java Engine" }]
    },
    "commands": [
      { "command": "egovvibe.configure", "title": "Evide: Set LLM API Key" }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.cjs",
    "dev": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "local:java": "node scripts/local-java.mjs",
    "package": "npm run build && vsce package --allow-missing-repository --skip-license --out evide.vsix",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
